{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "appstract/laravel-opcache": "^4.0",
        "darkaonline/l5-swagger": "^8.6",
        "laravel/framework": "^11.9",
        "laravel/horizon": "^5.29",
        "laravel/pulse": "^1.3",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.2",
        "laravel/tinker": "^2.9",
        "mailchimp/transactional": "^1.0",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-data": "^4.11"
    },
    "require-dev": {
        "brianium/paratest": "^7.6",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^2.9",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpmd/phpmd": "^2.15",
        "phpro/grumphp": "^2.9",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "php-cs-fixer-abstract": "php vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs": "@php-cs-fixer-abstract --dry-run --diff",
        "csf": "@php-cs-fixer-abstract",
        "lint": "composer cs",
        "lint-bf": "composer csf",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pr": "composer cs & composer phpstan & php artisan test",
        "docs": "php -d memory_limit=512M artisan l5-swagger:generate"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/ppapadimitriou/mailchimp-transactional-php"
        }
    ]
}
