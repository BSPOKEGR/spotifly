APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
ASSET_URL=${APP_URL}

WEB_CLIENT_URL=http://demo-demostrator.bspoke.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack_dev

DB_CONNECTION=pgsql
DB_HOST=spotifly-db
DB_PORT=5432
DB_DATABASE=spotifly-database
DB_USERNAME=admin
DB_PASSWORD=_

###> SANCTUM ###
SANCTUM_STATEFUL_DOMAINS=ves-frontend.bspoke.local
SESSION_DRIVER=redis
SESSION_DOMAIN=.bspoke.local
SESSION_SECURE_COOKIE=false#true on production
SESSION_LIFETIME=10080# 1 week
###> SANCTUM ###

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=spotifly-redis
REDIS_PASSWORD=_
REDIS_PORT=6379
REDIS_PREFIX=spotifly_

MAIL_MAILER=smtp
MAIL_HOST=mailer
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=your_email@example.com
MAIL_FROM_NAME=spotifly-api

# Mandrill template slugs (override to match the templates defined in your Mandrill account)
MANDRILL_TEMPLATE_REGISTER_USER=spotifly-register-user
MANDRILL_TEMPLATE_RESET_PASSWORD=spotifly-user-reset-password

###> TELESCOPE ###
TELESCOPE_ENABLED=true

# By default all telescope watchers are enabled, disable anyone that is not required here
TELESCOPE_REDIS_WATCHER=false
TELESCOPE_VIEW_WATCHER=false
TELESCOPE_DUMP_WATCHER=true
###< TELESCOPE ###

### PULSE ###
PULSE_SERVER_NAME=spotifly-pulse
###< PULSE ###

###> MISC ###
INTERNAL_IP_WHITELIST=127.0.0.1
ENABLE_IP_BLOCKER=true
###< MISC ###

TRUSTED_PROXIES=_

SWAGGER_IP_WHITELIST=

###> FARMCALENDAR API ###
FARMCALENDAR_API_URL=http://farmcalendar:8002
FARMCALENDAR_API_VERSION=v1
FARMCALENDAR_API_TIMEOUT=30
FARMCALENDAR_API_FORMAT=jsonld
FARMCALENDAR_AUTH_TYPE=
FARMCALENDAR_API_TOKEN=
FARMCALENDAR_API_USERNAME=
FARMCALENDAR_API_PASSWORD=
FARMCALENDAR_RETRY_TIMES=3
FARMCALENDAR_RETRY_SLEEP=1000
###< FARMCALENDAR API ###

###> WEATHER SERVICE API ###
WEATHERSERVICE_API_URL=http://weatherservice-app-1:8010
WEATHERSERVICE_API_TIMEOUT=30
WEATHERSERVICE_AUTH_TYPE=
WEATHERSERVICE_API_TOKEN=
WEATHERSERVICE_RETRY_TIMES=3
WEATHERSERVICE_RETRY_SLEEP=1000
###< WEATHER SERVICE API ###

###> PEST & DISEASE MANAGEMENT API ###
PESTDISEASE_API_URL=http://pd-pdm-1:8003
PESTDISEASE_API_VERSION=v1
PESTDISEASE_API_TIMEOUT=30
PESTDISEASE_API_USERNAME=
PESTDISEASE_API_PASSWORD=
PESTDISEASE_RETRY_TIMES=3
PESTDISEASE_RETRY_SLEEP=1000
###< PEST & DISEASE MANAGEMENT API ###
